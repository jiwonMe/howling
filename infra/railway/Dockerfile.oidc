# Railway `oidc` 서비스. 한 계정 issuer를 소스에서 빌드한다. 빌드 컨텍스트는 저장소 루트.
FROM node:22-bookworm AS builder
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
COPY infra/oidc ./infra/oidc
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @howling/oidc-test build
RUN pnpm --filter @howling/oidc-test --prod deploy --legacy /out/oidc \
 && cp -r infra/oidc/dist /out/oidc/dist

FROM node:22-bookworm-slim AS oidc
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /out/oidc /app
EXPOSE 8081
CMD ["node", "dist/main.js"]

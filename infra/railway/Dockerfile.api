# Railway `api` 서비스. core·contracts·api·web을 빌드하고, API 한 프로세스가 웹 번들도 낸다.
# 빌드 컨텍스트는 저장소 루트.
FROM node:22-bookworm AS builder
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
COPY infra/oidc ./infra/oidc
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @howling/core --filter @howling/contracts --filter @howling/api --filter @howling/web build
RUN pnpm --filter @howling/api --prod deploy --legacy /out/api \
 && cp -r apps/api/dist /out/api/dist \
 && cp -r apps/api/migrations /out/api/migrations \
 && cp -r apps/web/dist /out/web

FROM node:22-bookworm-slim AS api
ENV NODE_ENV=production
ENV API_HOST=0.0.0.0
ENV WEB_DIST=/app/web
WORKDIR /app/api
COPY --from=builder /out/api /app/api
COPY --from=builder /out/web /app/web
EXPOSE 3000
CMD ["node", "dist/main.js"]

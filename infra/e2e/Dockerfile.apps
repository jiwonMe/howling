FROM node:22-bookworm AS builder
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
COPY infra/oidc ./infra/oidc
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @howling/core --filter @howling/contracts --filter @howling/api --filter @howling/runtime --filter @howling/web --filter @howling/mcp-test build

FROM node:22-bookworm-slim AS api
WORKDIR /app
COPY --from=builder /app /app
CMD ["node", "apps/api/dist/main.js"]

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
COPY --from=builder /app /app
CMD ["node", "apps/runtime/dist/main.js"]

FROM nginx:1.27-alpine AS web
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY infra/e2e/nginx.conf /etc/nginx/conf.d/default.conf

FROM node:22-bookworm-slim AS mcp-test
WORKDIR /app
COPY --from=builder /app /app
ENV MCP_HOST=0.0.0.0
ENV MCP_PORT=8091
ENV MCP_TOKEN=test-mcp-token
CMD ["node", "apps/mcp-test/dist/http.js"]

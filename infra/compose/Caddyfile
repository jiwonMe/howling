{
	auto_https off
	https_port 443
}

howling.test {
	tls /certs/howling.test.crt /certs/howling.test.key
	@events path_regexp ^/api/v1/sites/.+/runs/.+/events$
	handle @events {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}
	handle /ready {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:80
	}
}

auth.howling.test {
	tls /certs/howling.test.crt /certs/howling.test.key
	reverse_proxy oidc:8081
}
